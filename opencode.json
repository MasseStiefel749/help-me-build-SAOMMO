{
	"$schema": "https://opencode.ai/config.json",
	"permissions": [
		{ "action": "question", "resource": "*", "effect": "deny" },
		{ "action": "webfetch", "resource": "*", "effect": "allow" },
		{ "action": "websearch", "resource": "*", "effect": "allow" },
		{ "action": "shell", "resource": "*", "effect": "allow" },
		{ "action": "external_directory", "resource": "D:/SecondBrain/*", "effect": "allow" },
		{ "action": "read", "resource": "D:/SecondBrain/*", "effect": "allow" },
		{ "action": "edit", "resource": "D:/SecondBrain/*", "effect": "allow" }
	],
	"agents": {
		"build": {
			"permissions": [
				{ "action": "question", "resource": "*", "effect": "deny" },
				{ "action": "webfetch", "resource": "*", "effect": "allow" },
				{ "action": "websearch", "resource": "*", "effect": "allow" }
			]
		}
	}
}
